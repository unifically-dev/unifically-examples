{
  "info": {
    "name": "Unifically API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Video, image, music and speech generation through one endpoint: POST /v1/tasks.\n\nSet the `api_key` collection variable (keys: https://unifically.com/api-keys). Run a **Price check** request first: `dry_run: true` returns the cost and charges nothing. Every **Create** request is charged to your balance and stores its `task_id`, so **Get task status** works straight after.\n\nDocs: https://docs.unifically.com"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.unifically.com"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Get account and balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "account"
              ]
            },
            "description": "Balance, email and timestamps for the key's account."
          }
        }
      ]
    },
    {
      "name": "Price check (free)",
      "item": [
        {
          "name": "Price check: Veo 3.1 Fast video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "tasks"
              ]
            },
            "description": "Validates the request and returns `data.cost`. No task is created and nothing is charged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"google/veo-3.1-fast\",\n  \"input\": {\n    \"prompt\": \"A golden retriever running along a beach at sunset, slow motion, cinematic lighting\",\n    \"duration\": 8\n  },\n  \"dry_run\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Price check: GPT Image 2",
