    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get task status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "tasks",
                "{{task_id}}"
              ]
            },
            "description": "`data.status` is `processing`, `completed` or `failed`. When completed, the result is in `data.output` (`video_url`, `image_url` or `audio_url`)."
          }
        },
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/tasks?status=completed&page_size=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "completed"
                },
                {
                  "key": "page_size",
                  "value": "25"
                }
              ]
            },
            "description": "Newest first. `page_size` is 10, 25, 50 or 100."
          }
        }
      ]
    }
  ]
}
