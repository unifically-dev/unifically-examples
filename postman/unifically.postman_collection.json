        {
          "name": "Create video with a webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "tasks"
              ]
            },
            "description": "`callback_url` goes at the top level, next to `model` and `input`. The API POSTs there when the task completes or fails.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"google/veo-3.1-fast\",\n  \"input\": {\n    \"prompt\": \"A golden retriever running along a beach at sunset, slow motion, cinematic lighting\",\n    \"duration\": 8\n  },\n  \"callback_url\": \"https://your-server.com/webhook\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.task_id) pm.collectionVariables.set('task_id', d.task_id);"
                ]
              }
            }
