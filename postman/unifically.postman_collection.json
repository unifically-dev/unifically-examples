              "raw": "{\n  \"model\": \"openai/gpt-image-2\",\n  \"input\": {\n    \"prompt\": \"A cozy wooden cabin in a snowy forest at dusk, warm light in the windows, photorealistic\",\n    \"resolution\": \"1K\"\n  },\n  \"dry_run\": true\n}",
